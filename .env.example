# ==============================================
# RESTAURANT APP ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ----------------------------------------------
# INSFORGE DATABASE CONFIGURATION
# ----------------------------------------------
# Get these from your InsForge project dashboard
VITE_INSFORGE_URL="https://arqsta8h.us-west.insforge.app"
VITE_INSFORGE_KEY="your_anon_key_here"

# Database URL (optional - uses InsForge default if not set)
# DATABASE_URL="postgresql://user:password@host:port/db"

# ----------------------------------------------
# AI PROVIDERS
# ----------------------------------------------
# Gemini API (primary - used for chat AND image extraction)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# Groq API (fallback - chat only, no image support)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=""

# ----------------------------------------------
# GOOGLE OAUTH (for Google Drive integration)
# ----------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------
# APP CONFIGURATION
# ----------------------------------------------
# URL where the app is hosted (for OAuth callbacks)
APP_URL="http://localhost:3000"

# Session secret for express-session (generate a random string)
SESSION_SECRET="change_this_to_a_random_secret_at_least_32_chars"

# ----------------------------------------------
# DEFAULT APP PIN (4 digits)
# ----------------------------------------------
# Security PIN for accessing sensitive sections
VITE_DEFAULT_PIN="1379"