# Neon CLI writes real connection strings into ignored .env.local (or an existing .env).
# Run neon deploy for the project/branch pinned in .neon. Never put these in VITE_* variables.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional AI and Google Drive services; unrelated to Neon Postgres setup.
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:4173
SESSION_SECRET=
