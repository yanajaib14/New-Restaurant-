# Client-side Vite variables (used in src/)
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_INSFORGE_URL="https://arqsta8h.us-west.insforge.app"
VITE_INSFORGE_KEY="ik_d3902514ce290fc64bb4900a677890ce"

# GEMINI_API_KEY: primary AI provider (chat + invoice image extraction)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: fallback AI provider (chat only — used when Gemini is unavailable)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth Credentials
# Obtain these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
