# Neon Postgres. Copy from Neon -> your project -> Connect. Keep server-side only;
# never put these in VITE_* variables. The same DATABASE_URL is set in Vercel.
# Pooled string (host contains "-pooler"): used by the app.
DATABASE_URL=
# Direct string (no "-pooler"): only needed for `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Optional AI and Google Drive services; unrelated to Neon Postgres setup.
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:4173
SESSION_SECRET=
