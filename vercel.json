{
  "env": {
    "APP_URL": "https://new-restaurant-pi.vercel.app"
  },
  "routes": [
    {
      "src": "/api/records/([^/?]+)",
      "dest": "/api/records?table=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
