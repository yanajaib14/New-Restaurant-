{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sync": "node --import tsx --test tests/todo-sync.test.ts",
    "test:browser": "node tests/workspace.browser.mjs && node tests/forms.browser.mjs && node tests/core-workspace.browser.mjs && node tests/onboarding.browser.mjs && node tests/mobile-workspace.browser.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "test:database-app": "npm run build && node --import tsx tests/neon-app.browser.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.18.2",
    "@vercel/functions": "^3.11.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
